# 本地开发环境变量示例（复制为 .env 或直接 export）
# 注意：本文件只放占位符，不要把真实密钥提交到仓库。

# ---- RAGFlow ----
RAGFLOW_BASE=http://localhost:9380
# RAGFlow 控制台 → 头像 → API → 创建 API Key（格式 ragflow-xxxx）
RAGFLOW_KEY=ragflow-your-key-here
RAGFLOW_DATASET=your-dataset-id

# ---- 本地推理（Ollama）----
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# ---- 问答服务调参 ----
TOP_K=8
SIM_THRESHOLD=0.2
MIN_SIM_TO_ANSWER=0.33
MAX_TOKENS=1536
CHUNK_CHARS=600
MAX_CTX_CHARS=3000
NUM_CTX=8192
HOST=127.0.0.1
PORT=8901

# ---- Embedding（bge-m3，OpenAI 兼容）----
MODEL_PATH=/path/to/bge-m3
EMBED_MAX_CHARS=12000
EMBED_MAX_BATCH=64
EMBED_DEVICE=cpu

# ---- 监控 / 预警 ----
PROM_URL=http://localhost:19090
ALERT_DATA_DIR=./monitoring/alert_service/data
MIN_SAMPLES=5
CONSECUTIVE=2
STALE_SECONDS=300

# ---- Dify 0.15.3（仅本地脚本使用）----
DIFY_BASE=http://localhost:8080
DIFY_EMAIL=admin@example.com
DIFY_PASSWORD=change-me
DIFY_MODEL_PROVIDER=ollama
DIFY_MODEL=deepseek-r1:7b

# ---- Grafana（docker-compose 默认值，生产请覆盖）----
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
